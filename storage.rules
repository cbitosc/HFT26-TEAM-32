rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /candidates/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.role == 'recruiter');
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
    match /reports/{reportId}.pdf {
      allow read: if true; // Publicly verifiable with report ID
      allow write: if false; // Server-only generation
    }
  }
}

