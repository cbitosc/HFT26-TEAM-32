# ======================================================================
# PROCTOR-FORGE ENVIRONMENT CONFIGURATION
# ======================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# ----------------------------------------------------------------------
# Featherless AI LLM Configuration (OpenAI-compatible)
# ----------------------------------------------------------------------
FEATHERLESS_API_KEY=fl_live_replace_with_your_api_key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL_GENERATOR=meta-llama/Meta-Llama-3.1-70B-Instruct
FEATHERLESS_MODEL_ASSISTANT=meta-llama/Meta-Llama-3.1-8B-Instruct
FEATHERLESS_MODEL_VALIDATOR=meta-llama/Meta-Llama-3.1-70B-Instruct
FEATHERLESS_MAX_RETRIES=3
FEATHERLESS_TIMEOUT_MS=45000
FEATHERLESS_CONCURRENCY_LIMIT=4

# ----------------------------------------------------------------------
# Runner Microservice Configuration (apps/runner)
# ----------------------------------------------------------------------
RUNNER_URL=http://localhost:5050
RUNNER_PORT=5050
RUNNER_HMAC_SECRET=c8f6e4a2b91d4e7a9b0c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3
RUNNER_EXEC_TIMEOUT_MS=6000
RUNNER_MEMORY_LIMIT_MB=256
RUNNER_CPU_QUOTA_MICROS=100000
RUNNER_PIDS_LIMIT=64
RUNNER_USE_GVISOR=false

