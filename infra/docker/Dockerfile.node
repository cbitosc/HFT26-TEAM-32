FROM node:20-slim

ENV NODE_ENV=test \
    NPM_CONFIG_UPDATE_NOTIFIER=false

# Security: create unprivileged sandbox user
RUN groupadd -g 1001 sandboxgroup && \
    useradd -u 1001 -g sandboxgroup -m -s /sbin/nologin sandboxuser

WORKDIR /sandbox

# Pre-install test runner libraries globally inside the container
RUN npm install -g vitest@1.3.1 jest@29.7.0 typescript@5.3.3

RUN chown -R sandboxuser:sandboxgroup /sandbox

USER sandboxuser

CMD ["node", "-e", "console.log('Proctor-Forge Node Sandbox Ready')"]

